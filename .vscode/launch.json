{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Express (tsx)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "--inspect"],
      "args": ["./src/app.ts"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}
